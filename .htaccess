# ============================================================
#  EINE ADRESSE FUER ALLES
#
#  Die Seite war unter putz-realestate.at UND unter
#  www.putz-realestate.at erreichbar — fuer Suchmaschinen sind das
#  zwei Websites mit demselben Inhalt, deren Staerke sich aufteilt
#  statt sich zu addieren. Das www wird deshalb dauerhaft (301) auf
#  die Adresse ohne www umgeleitet.
#
#  Diese Regel steht ganz oben, damit sie auch im Wartungsmodus
#  greift und Google beide Varianten sofort zusammenfuehrt.
#  Auf https leitet der Server bereits von sich aus um.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>


# ============================================================
#  Die Seite ist oeffentlich erreichbar.
#
#  Zum Offlinenehmen diesen Block hier wieder einsetzen — er muss
#  VOR den Adressregeln stehen, sonst beendet deren [L] den
#  Durchlauf und die 503-Regel greift nicht:
#
#    <IfModule mod_rewrite.c>
#      RewriteEngine On
#      RewriteCond %{REQUEST_URI} !^/wartung(\.html)?$
#      RewriteCond %{REQUEST_URI} !^/assets/img/logo\.png$
#      RewriteCond %{REQUEST_URI} !^/admin/
#      RewriteCond %{REQUEST_URI} !^/robots\.txt$
#      RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
#      RewriteRule ^ - [R=503,L]
#    </IfModule>
#    ErrorDocument 503 /wartung.html
# ============================================================

# ============================================================
#  ADRESSEN OHNE .html
#
#  Nach aussen gibt es nur noch /verkaufen, /referenzen und so
#  weiter. Zwei Schritte sind dafuer noetig:
#
#    1. Wer noch /verkaufen.html aufruft, wird dauerhaft (301) auf
#       /verkaufen geschickt. Ohne das haette jede Seite zwei
#       Adressen mit demselben Inhalt.
#    2. /verkaufen liefert intern verkaufen.html aus.
#
#  Geprueft wird THE_REQUEST, also die urspruengliche Anfrage —
#  die interne Umschreibung in Schritt 2 loest Schritt 1 deshalb
#  nicht erneut aus, es entsteht keine Schleife.
#
#  wartung.html bleibt aussen vor: darauf zeigt ErrorDocument.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html und /index -> /
  RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # /irgendwas.html -> /irgendwas
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/wartung\.html$
  RewriteRule ^ /%1 [R=301,L]

  # /irgendwas -> intern irgendwas.html ausliefern
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^([^.]+)$ $1.html [L]
</IfModule>


# ============================================================
#  Zwischenspeicher-Regeln
#
#  Hostinger legt vor die Seite ein CDN, das Antworten
#  standardmaessig eine Woche lang festhaelt. Fuer die
#  Objektdaten aus Justimmo waere das fatal: eine Aenderung in
#  Justimmo wuerde bis zu sieben Tage brauchen, bis sie auf der
#  Website ankommt.
#
#  Diese Regeln gelten unabhaengig vom Wartungsmodus und
#  muessen auch nach dem Wiederonlinegehen bestehen bleiben.
# ============================================================

<IfModule mod_headers.c>
  # Objektdaten: nie zwischenspeichern, weder im Browser noch im CDN.
  <FilesMatch "^justimmo\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always unset Expires
    Header always unset ETag
  </FilesMatch>

  # HTML-Seiten: kurz zwischenspeichern, aber immer beim Server rueckfragen.
  # Sonst sehen Besucher nach einer Aenderung tagelang die alte Fassung.
  # Waehrend des Wartungsmodus zusaetzlich wichtig, damit niemand die
  # Wartungsseite noch sieht, nachdem die Seite wieder online ist.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# CSS, JS, Bilder duerfen lange gespeichert bleiben — die tragen
# ohnehin eine Versionsnummer (?v=…) im Link.

