# ============================================================
#  WARTUNGSMODUS — die Seite ist oeffentlich nicht erreichbar.
#
#  Zum Wiederonlinegehen: den Rewrite-Block unten entfernen
#  (der Rest der Datei muss bleiben) und pushen.
#
#  Wirkt NUR auf dem Hostinger-Server. Lokal geoeffnete
#  Dateien sind davon nicht betroffen.
# ============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ausnahmen, die weiterhin ausgeliefert werden:
  #  - die Wartungsseite selbst (sonst Endlosschleife)
  #  - das Logo, das die Wartungsseite anzeigt
  #  - der passwortgeschuetzte Admin-Bereich, damit die
  #    Justimmo-Pruefung erreichbar bleibt
  RewriteCond %{REQUEST_URI} !^/wartung\.html$
  RewriteCond %{REQUEST_URI} !^/assets/img/logo\.png$
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteRule ^ - [R=503,L]
</IfModule>

# 503 = "voruebergehend nicht verfuegbar". Wichtig fuer Google:
# die Seite wird dadurch NICHT aus dem Index entfernt.
ErrorDocument 503 /wartung.html

<IfModule mod_headers.c>
  # Suchmaschinen: in einer Stunde wieder vorbeischauen.
  Header always set Retry-After "3600"
</IfModule>


# ============================================================
#  Zwischenspeicher-Regeln
#
#  Hostinger legt vor die Seite ein CDN, das Antworten
#  standardmaessig eine Woche lang festhaelt. Fuer die
#  Objektdaten aus Justimmo waere das fatal: eine Aenderung in
#  Justimmo wuerde bis zu sieben Tage brauchen, bis sie auf der
#  Website ankommt.
#
#  Diese Regeln gelten unabhaengig vom Wartungsmodus und
#  muessen auch nach dem Wiederonlinegehen bestehen bleiben.
# ============================================================

<IfModule mod_headers.c>
  # Objektdaten: nie zwischenspeichern, weder im Browser noch im CDN.
  <FilesMatch "^justimmo\.php$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always unset Expires
    Header always unset ETag
  </FilesMatch>

  # HTML-Seiten: kurz zwischenspeichern, aber immer beim Server rueckfragen.
  # Sonst sehen Besucher nach einer Aenderung tagelang die alte Fassung.
  # Waehrend des Wartungsmodus zusaetzlich wichtig, damit niemand die
  # Wartungsseite noch sieht, nachdem die Seite wieder online ist.
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# CSS, JS, Bilder duerfen lange gespeichert bleiben — die tragen
# ohnehin eine Versionsnummer (?v=…) im Link.
